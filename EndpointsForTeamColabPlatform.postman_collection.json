              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/two-factor/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "two-factor",
                "verify"
              ]
            },
            "description": "Note: this is a GET request with a body, which is non-standard — some HTTP clients strip bodies from GET requests. Postman sends it fine, but worth knowing this may not work from every client."
          },
          "response": []
        }
