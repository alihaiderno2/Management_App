        {
          "name": "Verify Email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/verify-email?token=paste-token-from-email-here",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
