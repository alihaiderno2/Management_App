// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
}

enum Role {
  OWNER
  USER
  ADMIN
}

enum ProjectRole {
  MANAGER
  CONTRIBUTOR
  VIEWER
}

enum ChatRoomType {
  PROJECT
  TEAM
  DIRECT
}

enum NotificationWays {
  APP
  EMAIL
  SLACK
}

// User Module
model User {
  id             String          @id @default(uuid())
  email          String          @unique
  passwordHash   String?
  name           String
  profileImage   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  twoFAEnabled   Boolean         @default(false)
  twoFASecret    String?
  isDeactivated   Boolean         @default(false)
  googleId       String?         @unique
  githubId       String?         @unique
  emailVerified Boolean @default(false)

  taskComments   TaskComment[]
  messages       Message[]
  attachments    Attachment[]
  notifications  notification[]
  calendarTokens CalendarToken?
  tasksAssigned          Task[] @relation("TaskAssignee")
  tasksCreated           Task[] @relation("TaskCreatedBy")
  refreshTokens  RefreshToken[]
  passwordResetTokens passwordResetToken[]

  projectMemberShips ProjectMember[]
  workspaceMemberships WorkspaceMember[]
  chatRooms ChatRoomParticipant[]
  sentInvites WorkspaceInvite[]
  disabledWorkspaceMemberships WorkspaceMember[] @relation("DisabledByUser")
}
model RefreshToken{
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

}
model passwordResetToken{
  id         String   @id @default(uuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

// WOrkspace Details
model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId   String

  projects  Project[]
  members   WorkspaceMember[]
  chatRooms ChatRoom[]
  invites   WorkspaceInvite[]
  disabled Boolean  @default(false)
}
// to define the workspace scope of the user
model WorkspaceMember {
  id          String   @id @default(uuid())
  workspaceId String
  userId      String
  role        Role     @default(USER)
  disabled    Boolean  @default(false)
  joinedAt    DateTime @default(now())
  diabledBy String?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])
  disabledByUser User? @relation("DisabledByUser", fields: [diabledBy], references: [id])

  @@unique([workspaceId, userId])
}

model WorkspaceInvite {
  id           String        @id @default(uuid())
  workspaceId  String
  email        String
  role         Role @default(USER)
  token        String        @unique
  invitedById  String
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime      @default(now())

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy    User          @relation(fields: [invitedById], references: [id])

  @@unique([workspaceId, email])
  @@index([email])
}

// Project Details
model Project {
  id                 String          @id @default(uuid())
  name               String
  description        String?
  workspaceId        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  createdById        Int
  workspace          Workspace?      @relation(fields: [workspaceId], references: [id])
  projectMemberShips ProjectMember[]
  sprints            Sprint[]
  tasks              Task[]
  chatRooms          ChatRoom[]
  attachments        Attachment[]
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      Role     @default(USER)
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
}

// Sprints inside the project
model Sprint {
  id        String   @id @default(uuid())
  projectId String
  name      String
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
  tasks   Task[]
}

// Tasks inside the project details
model Task {
  id          String       @id @default(uuid())
  projectId   String
  sprintId    String?
  title       String
  description String?
  dueDate     DateTime?

  createdByID String
  assigneeId  String?

  status    TaskStatus @default(BACKLOG)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  sprint       Sprint?       @relation(fields: [sprintId], references: [id])
  project      Project       @relation(fields: [projectId], references: [id])
  createdBy    User          @relation("TaskCreatedBy", fields: [createdByID], references: [id])
  assignee     User?         @relation("TaskAssignee", fields: [assigneeId], references: [id])
  taskComments TaskComment[]
  attachments  Attachment[]
}

// Comments on tasks
model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])
}

model chatRoom {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  messages Message[]
}

model ChatRoom {
  id          String       @id @default(uuid())
  name        String
  type        ChatRoomType
  projectId   String?
  workspaceId String?
  directKey   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project?   @relation(fields: [projectId], references: [id])
  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  participants ChatRoomParticipant[]
  messages  Message[]

  @@unique([projectId, type])
  @@unique([workspaceId, type])
}

model ChatRoomParticipant {
  id         String    @id @default(uuid())
  roomId     String
  userId     String
  lastReadAt DateTime?
  joinedAt   DateTime  @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatRoom ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
}

model Message {
  id        String   @id @default(uuid())
  roomId    String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  room        ChatRoom     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author      User         @relation(fields: [authorId], references: [id])
  attachments Attachment[]
  chatRoom    chatRoom?    @relation(fields: [chatRoomId], references: [id])
  chatRoomId  String?
}

// Attachments
model Attachment {
  id        String   @id @default(uuid())
  taskId    String?
  projectId String?
  messageId String?
  createdBy String
  fileName  String
  fileType  String
  fileSize  Int
  fileUrl   String
  createdAt DateTime @default(now())

  task    Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  message Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  creater User    @relation(fields: [createdBy], references: [id])
}

model notification {
  id        String           @id @default(uuid())
  userId    String
  way       NotificationWays
  payload   Json
  status    String
  createdAt DateTime         @default(now())
  sentAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CalendarToken{
  id        String   @id @default(uuid())
  userId    String   @unique
  accessToken     String?
  refreshToken    String
  expiresAt       DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}